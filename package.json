    "e2e:trainer": "node tests/e2e/trainer.cjs",
    "e2e:history": "node tests/e2e/history.cjs",
    "e2e:auto": "node tests/e2e/auto-advance.cjs",
    "e2e:home": "node tests/e2e/home.cjs",
